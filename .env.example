# Setup: the local stack and the tests. Compose reads this file for
# Postgres's passwords, and the tests read it to make a database per test
# package. The server reads none of it: its settings are in server/.env.
# `just setup` copies this to .env (gitignored). Development values only;
# never a real secret. Quote a value with spaces or & in it: both compose
# and the shell read this file.

# Postgres's superuser, and the role the server connects as.
CONDUIT_DB_ADMIN_PASSWORD=dev-admin-password
CONDUIT_DB_PASSWORD=dev-app-password

# Tests create each package's database through the superuser, then connect
# as the server's role, with the server's privileges.
CONDUIT_TEST_ADMIN_URL=postgres://postgres:dev-admin-password@127.0.0.1:5432/postgres?sslmode=disable
CONDUIT_TEST_DATABASE_URL=postgres://conduit:dev-app-password@127.0.0.1:5432/conduit?sslmode=disable
