# The server's own settings, and nothing else: the full list is in
# internal/config. `just dev-server` and `just migrate` load this file, and
# compose hands it to the server and migrate containers, pointing the
# database URL at the db container instead. `just setup` copies this to
# .env (gitignored). Development values only; never a real secret.

CONDUIT_DATABASE_URL=postgres://conduit:dev-app-password@127.0.0.1:5432/conduit?sslmode=disable
CONDUIT_API_TOKEN=dev-only-token-0123456789abcdef0123456789abcdef
CONDUIT_LOG_FORMAT=text

# Upstreams workflows may call. true turns the address check off, so a
# workflow can reach localhost and private networks: development only.
CONDUIT_ALLOW_PRIVATE_NETWORKS=false
CONDUIT_UPSTREAM_PORTS=80,443
# Runs in progress at once; past it, starting one answers 503.
CONDUIT_MAX_RUNS=32
# Run event streams open at once; past it, opening one answers 503. nginx
# also caps each client at 20 requests in progress.
CONDUIT_MAX_STREAMS=256
